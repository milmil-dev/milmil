# Compose-level variables only.
# App runtime secrets belong to api/.env(.example).
# Frontend variables belong to web/.env(.example).

API_PORT=8080
WEB_PORT=3000

# Container mount paths
DATA_DIR=./data
MEDIA_DIR=/mnt/media
DOWNLOAD_DIR=./downloads

# PostgreSQL (enable with: docker compose --profile postgres up -d)
POSTGRES_USER=milmil
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=milmil
