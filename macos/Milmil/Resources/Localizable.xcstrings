    "以目前的來源 / 解析度 / 字幕組建立 RSS 訂閱規則，之後新集數自動下載": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an RSS rule from the current source / resolution / sub-group; new episodes download automatically"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のソース / 解像度 / 字幕グループで RSS ルールを作成し、新しいエピソードを自動ダウンロードします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 소스 / 해상도 / 자막 그룹으로 RSS 규칙을 만들어 새 에피소드를 자동으로 내려받습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以目前的来源 / 分辨率 / 字幕组建立 RSS 订阅规则，之后新集数自动下载"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用而家嘅來源 / 解像度 / 字幕組建立 RSS 訂閱規則，之後新集數自動下載"
          }
        }
      }
    },
