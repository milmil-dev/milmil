            "value": "時間"
          }
        }
      }
    },
    "時間到會用 10 秒慢慢淡出再暫停；「播完這集停止」不會自動播下一集。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it fires the volume fades out over 10 s before pausing; “Stop after this episode” also skips autoplay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間になると 10 秒かけてフェードアウトしてから一時停止します。「この話が終わったら停止」は次の話を自動再生しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 되면 10초 동안 페이드아웃한 뒤 일시정지합니다. ‘이 에피소드 후 정지’는 다음 화를 자동 재생하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间到会用 10 秒慢慢淡出再暂停；“播完这集停止”不会自动播下一集。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "時間到會用 10 秒慢慢淡出再暫停；「播完呢集停」唔會自動播下一集。"
          }
        }
      }
    },
    "時間到會用 10 秒慢慢淡出再暫停；「播完這集停止」唔會自動播下一集。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the timer ends the volume fades out over 10 s, then playback pauses; “Stop after this episode” also skips auto-play of the next one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間になると 10 秒かけて音量を下げてから一時停止します。「この話が終わったら停止」では次の話を自動再生しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 되면 10초에 걸쳐 볼륨을 줄인 뒤 일시정지합니다. ‘이 에피소드 후 정지’는 다음 화 자동 재생도 하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间到会用 10 秒慢慢淡出再暂停；“播完这集停止”不会自动播下一集。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "時間到會用 10 秒慢慢淡出再暫停；「播完呢集停」唔會自動播下一集。"
          }
        }
      }
    },
