          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작품 페이지에서 “목록에 추가”를 누르거나, 재생을 시작하면 자동으로 “보는 중”에 추가됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
