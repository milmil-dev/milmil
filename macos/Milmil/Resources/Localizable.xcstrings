    "點「變更」後按下新的按鍵組合。與 web 共用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click “Change”, then press the new key combination. Shared with the web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「変更」をクリックして新しいキーの組み合わせを押してください。Web と共有されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“변경”을 누른 뒤 새 키 조합을 누르세요. 웹과 공유됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「变更」后按下新的按键组合。与 web 共用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "㩒「改」之後㩒新嘅按鍵組合。同 web 共用。"
          }
