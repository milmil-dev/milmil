        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip this every time?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この区間を毎回スキップ？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구간을 항상 건너뛸까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段自动跳过？"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢段自動跳過？"
          }
        }
      }
    },
    "這段自動跳過？側欄 › 視訊 可以記住": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip this every time? Remember it in Inspector › Video"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この区間を毎回スキップ？サイドバー › 映像 で記憶できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구간을 항상 건너뛸까요? 사이드바 › 비디오에서 기억할 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段自动跳过？侧栏 › 视频 可以记住"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢段自動跳過？側欄 › 視訊 可以記住"
          }
        }
      }
    },
