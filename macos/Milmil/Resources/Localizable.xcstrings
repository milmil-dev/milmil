      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a folder on the server; after a scan its titles show up on Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー上のフォルダを追加すると、スキャン後にホームで作品を見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 폴더를 추가하면 스캔 후 홈에서 작품을 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入服务器上的数据夹，扫描后就能在首页看到作品。"
