    "可用欄位：{{.Title}}、{{.Year}}、{{.Season}}、{{.EpisodeNumber}}、{{.EpisodeTitle}}、{{.Subgroup}}、{{.Resolution}}、{{.Ext}}；{{pad … 2}} 補零。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available fields: {{.Title}}, {{.Year}}, {{.Season}}, {{.EpisodeNumber}}, {{.EpisodeTitle}}, {{.Subgroup}}, {{.Resolution}}, {{.Ext}}; {{pad … 2}} zero-pads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用できるフィールド：{{.Title}}、{{.Year}}、{{.Season}}、{{.EpisodeNumber}}、{{.EpisodeTitle}}、{{.Subgroup}}、{{.Resolution}}、{{.Ext}}。{{pad … 2}} でゼロ埋め。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 필드: {{.Title}}, {{.Year}}, {{.Season}}, {{.EpisodeNumber}}, {{.EpisodeTitle}}, {{.Subgroup}}, {{.Resolution}}, {{.Ext}}; {{pad … 2}}는 0으로 채웁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用字段：{{.Title}}、{{.Year}}、{{.Season}}、{{.EpisodeNumber}}、{{.EpisodeTitle}}、{{.Subgroup}}、{{.Resolution}}、{{.Ext}}；{{pad … 2}} 补零。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可用欄位：{{.Title}}、{{.Year}}、{{.Season}}、{{.EpisodeNumber}}、{{.EpisodeTitle}}、{{.Subgroup}}、{{.Resolution}}、{{.Ext}}；{{pad … 2}} 補零。"
          }
        }
      }
    },
    "同一段你手動跳過兩次，播放器就會問要不要記住；沒有伺服器 OP/ED 資料的作品也跳得到。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip the same stretch by hand twice and the player offers to remember it — series without server OP/ED marks get skips too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ区間を手動で 2 回スキップすると記憶するか尋ねます。サーバーに OP/ED 情報がない作品でもスキップできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 구간을 두 번 직접 건너뛰면 기억할지 물어봅니다. 서버에 OP/ED 정보가 없는 작품도 건너뛸 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一段你手动跳过两次，播放器就会问要不要记住；没有服务器 OP/ED 数据的作品也跳得到。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "同一段你手動跳過兩次，播放器就會問要唔要記住；冇伺服器 OP/ED 資料嘅番都跳到。"
          }
        }
      }
    },
