{
  "openapi": "3.1.0",
  "info": {
    "title": "milmil API",
    "version": "1.0.0",
    "description": "Self-hosted anime media server"
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Local development" }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status":  { "type": "string", "example": "ok" },
                    "version": { "type": "string", "example": "1.0.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/status": {
      "get": {
        "summary": "Check if first-run setup has been completed",
        "operationId": "getAuthStatus",
        "tags": ["Auth"],
        "responses": {
          "200": {
            "description": "Setup status",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "initialized": { "type": "boolean" } } }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/setup": {
      "post": {
        "summary": "Create the initial admin user (first-run only)",
        "operationId": "postAuthSetup",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created — returns token + user" },
          "400": { "description": "Invalid input" },
          "403": { "description": "Already initialized" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate and receive an API token",
        "operationId": "postAuthLogin",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" },
                  "device_name": {
                    "type": "string",
                    "description": "Human-readable name for this session/device. Used as the token name if provided.",
                    "example": "My MacBook"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns API token and user object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string", "description": "API token (mlml_ prefix). Store securely — shown only once.", "example": "mlml_abc123xyz" },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id":       { "type": "string" },
                        "username": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid input" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/v1/auth/login/2fa": {
      "post": {
        "summary": "Complete login with a TOTP 2FA code",
        "operationId": "postAuthLogin2fa",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": { "type": "string", "description": "6-digit TOTP code" },
                  "device_name": {
                    "type": "string",
                    "description": "Human-readable name for this session/device.",
                    "example": "My MacBook"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns API token and user object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string", "description": "API token (mlml_ prefix). Store securely — shown only once.", "example": "mlml_abc123xyz" },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id":       { "type": "string" },
                        "username": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid or expired code" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Revoke the current API token (logout)",
        "operationId": "postAuthLogout",
        "tags": ["Auth"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "204": { "description": "Token revoked" } }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Get current authenticated user",
        "operationId": "getAuthMe",
        "tags": ["Auth"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id":       { "type": "string" },
                    "username": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/api-tokens": {
      "get": {
        "summary": "List all API tokens for the current user",
        "operationId": "listApiTokens",
        "tags": ["API Tokens"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Array of API tokens",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ApiToken" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new API token",
        "description": "Creates a named API token. The full token value is returned **only once** in this response — store it securely.",
        "operationId": "createApiToken",
        "tags": ["API Tokens"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "description": "Human-readable label for this token", "example": "Home server" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token created. The `token` field is shown only once.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiToken" },
                    {
                      "type": "object",
                      "properties": {
                        "token": { "type": "string", "description": "Full API token value (mlml_ prefix). Only returned on creation.", "example": "mlml_abc123xyz" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "description": "Invalid input" }
        }
      }
    },
    "/api/v1/api-tokens/current": {
      "get": {
        "summary": "Get info about the current session's API token",
        "operationId": "getCurrentApiToken",
        "tags": ["API Tokens"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current token info",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiToken" }
              }
            }
          }
        }
      }
    },
    "/api/v1/api-tokens/others": {
      "delete": {
        "summary": "Revoke all API tokens except the current one",
        "operationId": "revokeOtherApiTokens",
        "tags": ["API Tokens"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "All other tokens revoked" }
        }
      }
    },
    "/api/v1/api-tokens/{id}": {
      "delete": {
        "summary": "Revoke a specific API token by ID",
        "operationId": "revokeApiToken",
        "tags": ["API Tokens"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Token ID" }
        ],
        "responses": {
          "204": { "description": "Token revoked" },
          "404": { "description": "Token not found" }
        }
      }
    },
    "/api/v1/libraries": {
      "get": {
        "summary": "List all libraries",
        "operationId": "listLibraries",
        "tags": ["Libraries"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Array of libraries",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Library" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new library",
        "operationId": "createLibrary",
        "tags": ["Libraries"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "path"],
                "properties": {
                  "name": { "type": "string" },
                  "path": { "type": "string" },
                  "scan_interval_minutes": { "type": "integer", "default": 60 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Library created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Library" } } } },
          "400": { "description": "Invalid input or path does not exist" }
        }
      }
    },
    "/api/v1/libraries/{id}": {
      "get": {
        "summary": "Get a library by ID",
        "operationId": "getLibrary",
        "tags": ["Libraries"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Library details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Library" } } } },
          "404": { "description": "Library not found" }
        }
      },
      "put": {
        "summary": "Update a library",
        "operationId": "updateLibrary",
        "tags": ["Libraries"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "path"],
                "properties": {
                  "name": { "type": "string" },
                  "path": { "type": "string" },
                  "enabled": { "type": "boolean" },
                  "scan_interval_minutes": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Library updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Library" } } } },
          "400": { "description": "Invalid input" },
          "404": { "description": "Library not found" }
        }
      },
      "delete": {
        "summary": "Delete a library",
        "operationId": "deleteLibrary",
        "tags": ["Libraries"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Library deleted" }
        }
      }
    },
    "/api/v1/libraries/{id}/scan": {
      "post": {
        "summary": "Trigger a library scan",
        "operationId": "scanLibrary",
        "tags": ["Libraries"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Scan started" },
          "404": { "description": "Library not found" }
        }
      }
    },
    "/api/v1/libraries/{id}/scan-summaries": {
      "get": {
        "summary": "List recent scan summaries for a library",
        "operationId": "listScanSummaries",
        "tags": ["Libraries"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Array of scan summaries (last 10)",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ScanSummary" } }
              }
            }
          }
        }
      }
    },
    "/api/v1/discover/calendar": {
      "get": {
        "summary": "Daily airing schedule from Bangumi.tv",
        "operationId": "getCalendar",
        "tags": ["Discover"],
        "responses": {
          "200": {
            "description": "Array of calendar days with anime per weekday",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/CalendarDay" } }
              }
            }
          },
          "429": { "description": "Upstream rate limited" },
          "502": { "description": "External service unavailable" }
        }
      }
    },
    "/api/v1/discover/trending": {
      "get": {
        "summary": "Global trending anime from AniList, enriched with Bangumi Chinese titles",
        "operationId": "getTrending",
        "tags": ["Discover"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Array of trending anime",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/AnimeSummary" } }
              }
            }
          },
          "429": { "description": "Upstream rate limited" },
          "502": { "description": "External service unavailable" }
        }
      }
    },
    "/api/v1/discover/search": {
      "get": {
        "summary": "Search anime on Bangumi.tv",
        "operationId": "searchAnime",
        "tags": ["Discover"],
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/AnimeSummary" } }
              }
            }
          },
          "400": { "description": "Missing q parameter" },
          "429": { "description": "Upstream rate limited" },
          "502": { "description": "External service unavailable" }
        }
      }
    },
    "/api/v1/discover/anime/{id}": {
      "get": {
        "summary": "Anime detail by Bangumi ID, enriched with AniList cover and banner",
        "operationId": "getAnimeDetail",
        "tags": ["Discover"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Anime detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnimeDetail" }
              }
            }
          },
          "400": { "description": "Invalid ID" },
          "404": { "description": "Anime not found" },
          "429": { "description": "Upstream rate limited" },
          "502": { "description": "External service unavailable" }
        }
      }
    },
    "/api/v1/discover/anime/{id}/episodes": {
      "get": {
        "summary": "Episode list for an anime by Bangumi ID",
        "operationId": "getAnimeEpisodes",
        "tags": ["Discover"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Array of episodes",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Episode" } }
              }
            }
          },
          "400": { "description": "Invalid ID" },
          "429": { "description": "Upstream rate limited" },
          "502": { "description": "External service unavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API token (mlml_ prefix)",
        "description": "Pass an API token obtained from POST /api/v1/auth/login or POST /api/v1/api-tokens. Tokens have the prefix `mlml_`."
      }
    },
    "schemas": {
      "ApiToken": {
        "type": "object",
        "properties": {
          "id":            { "type": "string", "description": "Token ID" },
          "name":          { "type": "string", "description": "Human-readable label set at creation", "example": "Home server" },
          "token_prefix":  { "type": "string", "description": "First 8 characters of the token for identification", "example": "mlml_ab" },
          "last_used_at":  { "type": "string", "format": "date-time", "nullable": true },
          "last_ip":       { "type": "string", "nullable": true, "example": "192.168.1.10" },
          "last_user_agent": { "type": "string", "nullable": true },
          "created_at":    { "type": "string", "format": "date-time" },
          "is_current":    { "type": "boolean", "description": "True if this token belongs to the current request" }
        }
      },
      "Library": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "enabled": { "type": "integer", "description": "1 = enabled, 0 = disabled" },
          "scan_interval_minutes": { "type": "integer" },
          "last_scanned_at": { "type": "string", "nullable": true },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "ScanSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "library_id": { "type": "string" },
          "started_at": { "type": "string" },
          "completed_at": { "type": "string", "nullable": true },
          "files_found": { "type": "integer" },
          "files_matched": { "type": "integer" },
          "files_unmatched": { "type": "integer" },
          "errors": { "type": "string", "description": "JSON array string" }
        }
      },
      "AnimeSummary": {
        "type": "object",
        "properties": {
          "bangumi_id": { "type": "integer" },
          "anilist_id": { "type": "integer" },
          "title": { "type": "string", "description": "Chinese title preferred, fallback Japanese" },
          "title_original": { "type": "string", "description": "Original Japanese title" },
          "title_en": { "type": "string" },
          "cover_image": { "type": "string" },
          "air_date": { "type": "string" },
          "episode_count": { "type": "integer" },
          "score": { "type": "number" }
        }
      },
      "AnimeDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/AnimeSummary" },
          {
            "type": "object",
            "properties": {
              "synopsis": { "type": "string", "description": "Chinese synopsis from Bangumi" },
              "banner_image": { "type": "string" },
              "tags": { "type": "array", "items": { "type": "string" } },
              "popularity": { "type": "integer" },
              "rating": { "$ref": "#/components/schemas/Rating" }
            }
          }
        ]
      },
      "CalendarDay": {
        "type": "object",
        "properties": {
          "weekday": { "type": "string", "description": "Chinese weekday name" },
          "weekday_en": { "type": "string" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/AnimeSummary" } }
        }
      },
      "Episode": {
        "type": "object",
        "properties": {
          "bangumi_episode_id": { "type": "integer" },
          "sort": { "type": "number", "description": "Episode number (supports 12.5 for specials)" },
          "title": { "type": "string", "description": "Chinese title preferred" },
          "title_original": { "type": "string" },
          "air_date": { "type": "string" },
          "synopsis": { "type": "string" }
        }
      },
      "Rating": {
        "type": "object",
        "properties": {
          "score": { "type": "number" },
          "total": { "type": "integer" }
        }
      }
    }
  }
}
