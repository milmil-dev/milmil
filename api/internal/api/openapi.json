{
  "openapi": "3.1.0",
  "info": {
    "title": "milmil API",
    "version": "1.0.0",
    "description": "Self-hosted anime media server"
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Local development" }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status":  { "type": "string", "example": "ok" },
                    "version": { "type": "string", "example": "1.0.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/status": {
      "get": {
        "summary": "Check if first-run setup has been completed",
        "operationId": "getAuthStatus",
        "tags": ["Auth"],
        "responses": {
          "200": {
            "description": "Setup status",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "initialized": { "type": "boolean" } } }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/setup": {
      "post": {
        "summary": "Create the initial admin user (first-run only)",
        "operationId": "postAuthSetup",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created — returns token + user" },
          "400": { "description": "Invalid input" },
          "403": { "description": "Already initialized" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate and receive a JWT",
        "operationId": "postAuthLogin",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Returns token + user object" },
          "400": { "description": "Invalid input" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Logout (client discards token)",
        "operationId": "postAuthLogout",
        "tags": ["Auth"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "204": { "description": "Logged out" } }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Get current authenticated user",
        "operationId": "getAuthMe",
        "tags": ["Auth"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id":       { "type": "string" },
                    "username": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
