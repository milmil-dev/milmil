# API runtime variables
DATABASE_URL=sqlite://data/milmil.db
JWT_SECRET=change_me_in_production_min_32_chars

# Redis credentials (for redis ACL user)
REDIS_USERNAME=milmil_app
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://milmil_app:change_me_redis_password@localhost:6379

# Optional integrations
ARIA2_RPC_URL=http://localhost:6800/jsonrpc
ARIA2_RPC_SECRET=milmil_secret
DANDANPLAY_APP_ID=
DANDANPLAY_APP_SECRET=
