# ============================================================================
# milmil API runtime configuration
# ----------------------------------------------------------------------------
# Required vars have no sensible default and the server will refuse to start.
# Optional vars fall back to the documented default if unset.
# ============================================================================

# --- Required ---------------------------------------------------------------
# Database connection. SQLite for dev, PostgreSQL for production.
#   sqlite://data/milmil.db
#   postgres://user:password@host:5432/dbname?sslmode=disable
DATABASE_URL=sqlite://data/milmil.db

# JWT signing key. Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_in_production_min_32_chars

# --- Security (recommended) -------------------------------------------------
# AES-256 key for encrypting stored credentials (rclone tokens, OAuth, etc).
# Falls back to JWT_SECRET if unset. Generate with: openssl rand -hex 32
# MILMIL_ENCRYPTION_KEY=

# --- Server -----------------------------------------------------------------
# API_PORT=8080
# DATA_DIR=./data
# DEBUG=0

# --- Cache (optional) -------------------------------------------------------
# Leave REDIS_URL empty to use in-memory cache (dev-only).
REDIS_URL=
# Fail startup if Redis is configured but unreachable (recommended in prod)
# REDIS_FAIL_FAST=0

# Redis ACL (used by docker-compose redis service only, not by the API)
REDIS_USERNAME=milmil_app
REDIS_PASSWORD=change_me_redis_password

# --- Torrent client ---------------------------------------------------------
# TORRENT_LISTEN_PORT=42069
# SEED_RATIO=1.0
# SEED_TIME_MINUTES=60

# --- Auto-provisioned admin (first-boot only) -------------------------------
# If set on first start, creates this admin user. Remove after setup.
# ADMIN_USER=
# ADMIN_PASSWORD=

# --- External integrations (optional) ---------------------------------------
# DandanPlay file hash matching + danmaku comments
DANDANPLAY_APP_ID=
DANDANPLAY_APP_SECRET=

# Custom danmu_api proxy (optional, defaults to public endpoint)
# DANMU_API_URL=

# Rclone remote config file path (for cloud storage backends)
# RCLONE_CONFIG=/app/data/rclone.conf
