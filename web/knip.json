{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.tsx", "vite.config.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/components/ui/**", "src/test/**", "**/index.ts"],
  "ignoreDependencies": [
    "@radix-ui/*",
    "tailwindcss",
    "tw-animate-css",
    "@testing-library/*",
    "babel-plugin-react-compiler",
    "@dotenvx/dotenvx"
  ],
  "ignoreExportsUsedInFile": true
}
