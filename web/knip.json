{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/sw.ts",
    "lingui.config.ts",
    "e2e/**/*.spec.ts",
    "src/components/ui/**",
    "src/lib/get-strict-context.tsx"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/test/**", "src/locales/**"],
  "ignoreDependencies": [
    "@fontsource-variable/.*",
    "@tailwindcss/typography",
    "tailwindcss",
    "tw-animate-css",
    "shadcn"
  ],
  "ignoreExportsUsedInFile": true
}
