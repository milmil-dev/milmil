# Dev only: absolute URL the frontend hits when the Vite dev server (5173)
# and the API (8080) live on different origins. Leave UNSET in production
# Docker builds — the bundled frontend then issues same-origin relative
# requests that the inner nginx proxies to /api/* and /ws.
VITE_API_URL=http://localhost:8080
VITE_ENABLE_SW=false
